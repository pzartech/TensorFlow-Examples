# Postgres / Supabase connection string
DATABASE_URL=postgres://user:password@host:5432/ici

# Didit credentials (keep server-side only — never expose to the browser)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Anchoring providers — enable as MANY as you want. Each adds an independent
# proof over the same Merkle root. Only hashes ever leave the system; never PII.
# ---------------------------------------------------------------------------

# Bitcoin via OpenTimestamps — on by default. Set to 1 to disable.
OTS_DISABLED=

# RFC 3161 timestamp authorities — comma-separated. One qualified proof per URL.
# For eIDAS legal presumption, use QTSPs on the EU Trusted List. freeTSA is only
# for testing (not qualified). e.g.:
# TSA_URLS=https://freetsa.org/tsr,https://timestamp.sectigo.com/qualified
TSA_URLS=

# EVM chains — shared key, then one "name=rpcUrl" per chain (comma-separated).
# EVM_PRIVATE_KEY=0x...
# EVM_ANCHORS=polygon=https://polygon-rpc.com,arbitrum=https://arb1.arbitrum.io/rpc
EVM_PRIVATE_KEY=
EVM_ANCHORS=

# Managed-key signature (Ed25519). Public key alone is enough to verify.
# Put the private key in an HSM/KMS in production (see signature-anchor.ts).
SIGNING_KEY_ID=
SIGNING_KEY_PEM=
SIGNING_PUBKEY_PEM=

# ---------------------------------------------------------------------------
# Replication sinks — store the FULL record in as MANY independent layers as you
# want, so the information survives even if the primary DB is lost/tampered.
# Keep every layer encrypted + access-controlled (payloads may contain PII).
# ---------------------------------------------------------------------------

# Append-only filesystem dirs (mount as WORM/NFS for immutability). Comma-sep.
# FS_SINKS=/mnt/worm/audit,/backup/audit
FS_SINKS=

# S3 buckets (enable Object Lock on the bucket for WORM). Uses standard AWS env.
# S3_SINKS=ici-audit-primary,ici-audit-dr
S3_SINKS=

# Azure blob containers (set an immutability policy for WORM).
# AZURE_BLOB_SINKS=audit1,audit2
AZURE_BLOB_SINKS=
AZURE_STORAGE_CONNECTION_STRING=
